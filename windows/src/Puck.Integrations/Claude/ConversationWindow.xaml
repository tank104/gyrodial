<Window x:Class="Puck.Integrations.Claude.ConversationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Puck · Claude" Width="440" Height="600" MinWidth="320" MinHeight="300"
        WindowStartupLocation="CenterScreen" Background="#0A0A0B" Foreground="#F5F5F7"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" ShowInTaskbar="True">
  <Window.Resources>
    <SolidColorBrush x:Key="Card" Color="#1C1C1E" />
    <SolidColorBrush x:Key="Mute" Color="#8E8E93" />
    <SolidColorBrush x:Key="Coral" Color="#D97757" />
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Margin="20,18,20,10">
      <TextBlock Text="Claude" FontSize="20" FontWeight="SemiBold" />
      <TextBlock Text="What you said on the puck, and what Claude answered." Foreground="{StaticResource Mute}" Margin="0,2,0,0" />
    </StackPanel>

    <TextBlock x:Name="Empty" Grid.Row="1" Text="Tap the Claude face on the puck and talk." Foreground="{StaticResource Mute}"
               HorizontalAlignment="Center" VerticalAlignment="Center" />

    <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,4,16,16">
      <ItemsControl x:Name="List">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="0,8,0,8">
              <!-- you, on the right -->
              <Border HorizontalAlignment="Right" MaxWidth="320" CornerRadius="14" Padding="12,8" Background="#2C2C2E">
                <TextBlock Text="{Binding You}" TextWrapping="Wrap" />
              </Border>
              <!-- Claude, on the left -->
              <Border HorizontalAlignment="Left" MaxWidth="340" CornerRadius="14" Padding="12,8" Margin="0,6,0,0" Background="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="Claude" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Coral}" Margin="0,0,0,2" />
                  <TextBlock Text="{Binding Claude}" TextWrapping="Wrap">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Failed}" Value="True">
                            <Setter Property="Foreground" Value="#FF453A" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </StackPanel>
              </Border>
              <TextBlock Text="{Binding At, StringFormat=t}" FontSize="11" Foreground="#5A5A5E" HorizontalAlignment="Left" Margin="4,4,0,0" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</Window>
