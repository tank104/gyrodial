<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Windows 11 dark, with the dial's yellow as the accent. Surfaces are translucent so they read
         the same over Mica/Acrylic and over the solid fallback. -->
    <Color x:Key="Color.Window">#FF202020</Color>
    <Color x:Key="Color.Accent">#FFFFD60A</Color>

    <SolidColorBrush x:Key="Brush.Window" Color="#FF202020" />
    <SolidColorBrush x:Key="Brush.WindowTint" Color="#C8202020" />
    <SolidColorBrush x:Key="Brush.MicaTint" Color="#30202020" />
    <SolidColorBrush x:Key="Brush.FlyoutTint" Color="#E6242424" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="#17FFFFFF" />
    <SolidColorBrush x:Key="Brush.SurfacePressed" Color="#0BFFFFFF" />
    <SolidColorBrush x:Key="Brush.SurfaceStrong" Color="#FF2D2D2D" />
    <SolidColorBrush x:Key="Brush.Control" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="Brush.ControlHover" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="Brush.Popup" Color="#FF2C2C2C" />
    <SolidColorBrush x:Key="Brush.Stroke" Color="#17FFFFFF" />
    <SolidColorBrush x:Key="Brush.StrokeStrong" Color="#30FFFFFF" />
    <SolidColorBrush x:Key="Brush.Text" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#C5FFFFFF" />
    <SolidColorBrush x:Key="Brush.TextTertiary" Color="#87FFFFFF" />
    <SolidColorBrush x:Key="Brush.TextDisabled" Color="#5DFFFFFF" />
    <SolidColorBrush x:Key="Brush.Accent" Color="#FFFFD60A" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#FFFFE04D" />
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#FFE6C000" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#24FFD60A" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#FF1A1A1A" />
    <!-- toggles, slider fills, progress: the yellow itself reads well on dark -->
    <SolidColorBrush x:Key="Brush.AccentControl" Color="#FFFFD60A" />
    <SolidColorBrush x:Key="Brush.OnAccentControl" Color="#FF1A1A1A" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#FFFF6B5E" />
    <SolidColorBrush x:Key="Brush.Success" Color="#FF5AD26A" />
    <SolidColorBrush x:Key="Brush.Knob" Color="#C5FFFFFF" />
    <SolidColorBrush x:Key="Brush.Selection" Color="#12FFFFFF" />
</ResourceDictionary>
