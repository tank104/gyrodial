<Window x:Class="Gyrodial.App.UI.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Gyrodial.App.UI"
        Title="Gyrodial" Width="380" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Background="Transparent" FontFamily="{StaticResource Font.Text}" FontSize="14"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <!-- keeps the DWM frame (shadow, rounded corners, backdrop) on a borderless window -->
        <WindowChrome CaptionHeight="0" GlassFrameThickness="-1" ResizeBorderThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <ui:VisibleWhen x:Key="Visible" />
        <!-- a step of the three pairing numbers: filled once dialled in -->
        <Style x:Key="PairStep" TargetType="Ellipse">
            <Setter Property="Width" Value="9" />
            <Setter Property="Height" Value="9" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="Stroke" Value="{DynamicResource Brush.Accent}" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="Fill" Value="Transparent" />
        </Style>
    </Window.Resources>

    <Border x:Name="Root" Background="{DynamicResource Brush.FlyoutTint}" BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="1"
            TextElement.Foreground="{DynamicResource Brush.Text}">
        <StackPanel Margin="20,16,20,18">

            <!-- header: name, a dot that says whether a dial is connected, more, settings -->
            <Grid Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="10" Height="10" Margin="0,0,10,0">
                        <Ellipse Fill="{DynamicResource Brush.Accent}" Visibility="{Binding IsConnected, Converter={StaticResource Visible}}" />
                        <Ellipse Stroke="{DynamicResource Brush.TextTertiary}" StrokeThickness="1.5"
                                 Visibility="{Binding IsConnected, Converter={StaticResource Visible}, ConverterParameter=not}" />
                    </Grid>
                    <TextBlock Text="Gyrodial" Style="{StaticResource Text.BodyStrong}" FontSize="15" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="MoreButton" Style="{StaticResource Button.Subtle}" ToolTip="More" Click="OnMore" Margin="0,0,2,0">
                        <TextBlock Text="&#xE712;" Style="{StaticResource Text.Icon}" />
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Pair another dial" Click="OnPair" />
                                <MenuItem Header="Install firmware…" Click="OnInstall" />
                                <MenuItem Header="Open the log" Click="OnLog" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Style="{StaticResource Button.Subtle}" ToolTip="Settings" Click="OnSettings">
                        <TextBlock Text="&#xE713;" Style="{StaticResource Text.Icon}" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- the dial: connected -->
            <Grid Visibility="{Binding IsConnected, Converter={StaticResource Visible}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:DialPreview Width="112" Height="112" Volume="{Binding Volume}" Muted="{Binding Muted}" Face="{Binding Face}"
                                IsConnected="{Binding IsConnected}" />
                <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Subtitle}" TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource Brush.Success}" Margin="0,1,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ConnectionText}" Style="{StaticResource Text.Secondary}" FontSize="13" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding BatteryText, Converter={StaticResource Visible}}">
                        <ui:BatteryGauge Level="{Binding Battery}" Charging="{Binding Charging}" Foreground="{DynamicResource Brush.TextSecondary}"
                                         Margin="0,1,8,0" VerticalAlignment="Center" Visibility="{Binding HasBattery, Converter={StaticResource Visible}}" />
                        <TextBlock Text="{Binding BatteryText}" Style="{StaticResource Text.Secondary}" FontSize="13" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- pairing: the dial is showing its numbers -->
            <Border Style="{StaticResource Card}" Padding="18,16" Visibility="{Binding IsPairing, Converter={StaticResource Visible}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- the dial's glass with the three numbers to dial as dots -->
                    <Grid Width="64" Height="64" VerticalAlignment="Top">
                        <Ellipse Fill="#FF050506" Stroke="{DynamicResource Brush.Accent}" StrokeThickness="3" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse>
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse" BasedOn="{StaticResource PairStep}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Step1Done}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource Brush.Accent}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <Ellipse>
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse" BasedOn="{StaticResource PairStep}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Step2Done}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource Brush.Accent}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <Ellipse>
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse" BasedOn="{StaticResource PairStep}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Step3Done}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource Brush.Accent}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                        </StackPanel>
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0">
                        <TextBlock Text="{Binding PairingTitle}" Style="{StaticResource Text.BodyStrong}" FontSize="16" />
                        <TextBlock Style="{StaticResource Text.Body}" Margin="0,6,0,0" Foreground="{DynamicResource Brush.TextSecondary}"
                                   Text="Your dial is showing a number. Turn the dial until it matches, then tap the glass. Three numbers in all." />
                        <TextBlock Text="{Binding PairingProgressText}" Style="{StaticResource Text.BodyStrong}" FontSize="13" Margin="0,8,0,0" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Text.Caption}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0"
                                       Text="The dial's side button cancels too." />
                            <Button Grid.Column="1" Content="Cancel" VerticalAlignment="Center" Click="OnCancelPairing" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- how the last pairing attempt ended -->
            <Border Style="{StaticResource Card}" Padding="18,16" Visibility="{Binding ShowNotice, Converter={StaticResource Visible}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Text.Icon}" FontSize="20" Foreground="{DynamicResource Brush.TextSecondary}"
                               VerticalAlignment="Top" Margin="0,2,14,0" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding NoticeTitle}" Style="{StaticResource Text.BodyStrong}" FontSize="16" />
                        <TextBlock Text="{Binding NoticeDetail}" Style="{StaticResource Text.Body}" Margin="0,6,0,0"
                                   Foreground="{DynamicResource Brush.TextSecondary}" />
                        <Button Content="{Binding RetryLabel}" Style="{StaticResource Button.Accent}" HorizontalAlignment="Left" Margin="0,12,0,0"
                                MinWidth="120" IsEnabled="{Binding CanRetry}" Click="OnPair" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- searching -->
            <StackPanel Visibility="{Binding ShowSearch, Converter={StaticResource Visible}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:DialPreview Width="88" Height="88" IsConnected="False" Opacity="0.85" />
                    <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SearchingTitle}" Style="{StaticResource Text.BodyStrong}" FontSize="16" />
                        <TextBlock Text="{Binding SearchingDetail}" Style="{StaticResource Text.Body}" Margin="0,4,0,0"
                                   Foreground="{DynamicResource Brush.TextSecondary}" FontSize="13" />
                    </StackPanel>
                </Grid>

                <!-- the pairing window is open: any dial that turns up is taken -->
                <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,14,0,0"
                        Visibility="{Binding ShowPairingWindow, Converter={StaticResource Visible}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:Spinner Width="18" Height="18" Stroke="{DynamicResource Brush.Accent}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center" Style="{StaticResource Text.Body}">
                            <Run Text="Ready to pair · " /><Run Text="{Binding PairingCountdown, Mode=OneWay}" />
                        </TextBlock>
                        <Button Grid.Column="2" Content="Cancel" Click="OnCancelPairing" />
                    </Grid>
                </Border>

                <!-- an ESP32-S3 that doesn't answer as a dial -->
                <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,14,0,0"
                        Visibility="{Binding HasForeignBoard, Converter={StaticResource Visible}}">
                    <StackPanel>
                        <TextBlock Text="{Binding ForeignText}" Style="{StaticResource Text.BodyStrong}" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Text="If it's your dial, install Gyrodial on it. Installing replaces whatever is on that board." />
                        <Button Content="Install Gyrodial…" HorizontalAlignment="Left" Margin="0,10,0,0" Click="OnInstallForeign" />
                    </StackPanel>
                </Border>

                <!-- after a while of looking -->
                <TextBlock Style="{StaticResource Text.Caption}" Margin="2,12,0,0" TextWrapping="Wrap"
                           Visibility="{Binding ShowCantFind, Converter={StaticResource Visible}}">
                    <Run Text="Can't find it? Use a USB-C cable that carries data (some only charge), or hold BOOT on the board while you plug it in." />
                    <Hyperlink Click="OnLog" Foreground="{DynamicResource Brush.TextSecondary}">Open the log</Hyperlink>
                </TextBlock>
            </StackPanel>

            <!-- now playing -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="14,10"
                    Visibility="{Binding HasMedia, Converter={StaticResource Visible}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding NowSourceUpper}" Style="{StaticResource Text.Caption}" FontSize="11" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding NowTitle}" Style="{StaticResource Text.BodyStrong}" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding NowArtist}" Style="{StaticResource Text.Secondary}" />
                    </StackPanel>
                    <Border Grid.Column="1" Width="32" Height="32" CornerRadius="16" Background="{DynamicResource Brush.AccentSoft}"
                            VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="{Binding PlayGlyph}" Style="{StaticResource Text.Icon}" FontSize="12" HorizontalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>

            <!-- integrations -->
            <ItemsControl ItemsSource="{Binding Integrations}" Margin="0,12,0,0">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <Border Style="{StaticResource Card}" Padding="0,4">
                            <ItemsPresenter />
                        </Border>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="ui:IntegrationItem">
                        <Grid Margin="14,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource Text.Icon}" Margin="0,0,14,0" Foreground="{DynamicResource Brush.TextSecondary}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayName}" Style="{StaticResource Text.BodyStrong}" FontWeight="Normal" />
                                <TextBlock Text="{Binding ShownStatus}" Style="{StaticResource Text.Secondary}" TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding ShownStatus, Converter={StaticResource Visible}}" />
                            </StackPanel>
                            <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Enabled}" Margin="12,0,0,0"
                                      Visibility="{Binding HasToggle, Converter={StaticResource Visible}}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- the one action worth a button while nothing's connected -->
            <Button Margin="0,16,0,0" Content="Pair a dial" Style="{StaticResource Button.Accent}" HorizontalAlignment="Stretch"
                    Visibility="{Binding ShowPairButton, Converter={StaticResource Visible}}" Click="OnPair" />
        </StackPanel>
    </Border>
</Window>
