<Project Sdk="Microsoft.NET.Sdk">
  <!-- gyrodial-hook.exe: the Claude Code hook command. Reads the hook JSON on stdin, asks the Gyrodial app
       (http://127.0.0.1:<port>), and prints the decision. Silent no-op when Gyrodial isn't running. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>gyrodial-hook</AssemblyName>
    <RootNamespace>GyrodialHook</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <!-- No reflection-based serialization, so it can be trimmed or published AOT. -->
    <IsAotCompatible>true</IsAotCompatible>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>
</Project>
