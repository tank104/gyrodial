<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Windows 11 light. Yellow stays a fill (with dark text on it), never text on white. -->
    <Color x:Key="Color.Window">#FFF3F3F3</Color>
    <Color x:Key="Color.Accent">#FFFFD60A</Color>

    <SolidColorBrush x:Key="Brush.Window" Color="#FFF3F3F3" />
    <SolidColorBrush x:Key="Brush.WindowTint" Color="#C8F3F3F3" />
    <SolidColorBrush x:Key="Brush.MicaTint" Color="#30F3F3F3" />
    <SolidColorBrush x:Key="Brush.FlyoutTint" Color="#E8F5F5F5" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="#E6FFFFFF" />
    <SolidColorBrush x:Key="Brush.SurfacePressed" Color="#80FFFFFF" />
    <SolidColorBrush x:Key="Brush.SurfaceStrong" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.Control" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="Brush.ControlHover" Color="#80F9F9F9" />
    <SolidColorBrush x:Key="Brush.Popup" Color="#FFF9F9F9" />
    <SolidColorBrush x:Key="Brush.Stroke" Color="#14000000" />
    <SolidColorBrush x:Key="Brush.StrokeStrong" Color="#29000000" />
    <SolidColorBrush x:Key="Brush.Text" Color="#E4000000" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#9E000000" />
    <SolidColorBrush x:Key="Brush.TextTertiary" Color="#72000000" />
    <SolidColorBrush x:Key="Brush.TextDisabled" Color="#5C000000" />
    <SolidColorBrush x:Key="Brush.Accent" Color="#FFFFD60A" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#FFFFDE3D" />
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#FFF0C800" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#33FFD60A" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#FF1A1A1A" />
    <!-- Toggles, slider fills, progress: the yellow is 1.4:1 on this background, below the 3:1 a
         control needs, so they use a deep gold (about 5:1) with a white knob. -->
    <SolidColorBrush x:Key="Brush.AccentControl" Color="#FF8A6D00" />
    <SolidColorBrush x:Key="Brush.OnAccentControl" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#FFC42B1C" />
    <SolidColorBrush x:Key="Brush.Success" Color="#FF0F7B0F" />
    <SolidColorBrush x:Key="Brush.Knob" Color="#9E000000" />
    <SolidColorBrush x:Key="Brush.Selection" Color="#0A000000" />
</ResourceDictionary>
