<Window x:Class="Puck.App.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Puck.App.UI"
        xmlns:app="clr-namespace:Puck.App"
        Title="Puck Settings" Width="980" Height="700" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Brush.Window}"
        FontFamily="{StaticResource Font.Text}" FontSize="14" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <ui:VisibleWhen x:Key="Visible" />
        <ui:Not x:Key="Not" />
        <ui:NumberFormat x:Key="Fmt" />

        <!-- page scaffolding -->
        <Style x:Key="Page" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Focusable" Value="False" />
        </Style>
        <Style x:Key="PageBody" TargetType="StackPanel">
            <Setter Property="Margin" Value="28,20,36,32" />
            <Setter Property="MaxWidth" Value="820" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="RowTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="RowDetail" TargetType="TextBlock" BasedOn="{StaticResource Text.Secondary}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="None" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="RowIcon" TargetType="TextBlock" BasedOn="{StaticResource Text.Icon}">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Margin" Value="2,0,18,0" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        </Style>
        <Style x:Key="ValueText" TargetType="TextBlock" BasedOn="{StaticResource Text.Secondary}">
            <Setter Property="MinWidth" Value="48" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <TabControl x:Name="Nav" Style="{StaticResource NavTabControl}" ItemContainerStyle="{StaticResource NavItem}"
                    SelectionChanged="OnNavChanged">

            <!-- ============================================================ General -->
            <TabItem Header="General" Tag="&#xE80F;" x:Name="GeneralTab">
                <ScrollViewer Style="{StaticResource Page}">
                    <StackPanel Style="{StaticResource PageBody}">
                        <TextBlock Text="General" Style="{StaticResource Text.Title}" Margin="0,0,0,20" />

                        <!-- the puck at a glance -->
                        <Border Style="{StaticResource Card}" Padding="20,18" Margin="0,0,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:PuckPreview Width="84" Height="84" Volume="{Binding App.Volume}" Muted="{Binding App.Muted}"
                                                Face="{Binding App.Face}" IsConnected="{Binding App.IsConnected}" />
                                <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding App.Title}" Style="{StaticResource Text.Subtitle}" />
                                    <TextBlock Text="{Binding App.ConnectionText}" Style="{StaticResource Text.Secondary}" FontSize="13" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding App.BatteryText}" Style="{StaticResource Text.Secondary}" FontSize="13" Margin="0,2,0,0"
                                               Visibility="{Binding App.BatteryText, Converter={StaticResource Visible}}" />
                                </StackPanel>
                                <Button Grid.Column="2" Content="Pair a puck" VerticalAlignment="Center" Command="{Binding PairCommand}" />
                            </Grid>
                        </Border>

                        <TextBlock Text="App" Style="{StaticResource Text.Section}" />
                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE7E8;" Style="{StaticResource RowIcon}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Start with Windows" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="Puck waits in the tray, ready for the puck to connect." Style="{StaticResource RowDetail}" />
                                </StackPanel>
                                <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding StartWithWindows}" Content="{Binding StartWithWindows, Converter={x:Static ui:OnOff.Instance}}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xECF0;" Style="{StaticResource RowIcon}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Prefer USB" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="When the puck is plugged in, talk over the cable instead of Bluetooth. Faster, and no radio." Style="{StaticResource RowDetail}" />
                                </StackPanel>
                                <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding PreferUsb}" Content="{Binding PreferUsb, Converter={x:Static ui:OnOff.Instance}}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE767;" Style="{StaticResource RowIcon}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Volume overlay" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="Show the volume on screen while you turn the puck." Style="{StaticResource RowDetail}" />
                                </StackPanel>
                                <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowVolumeOverlay}" Content="{Binding ShowVolumeOverlay, Converter={x:Static ui:OnOff.Instance}}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================================================ Puck -->
            <TabItem Header="Puck" Tag="&#xEA3A;" x:Name="PuckTab">
                <ScrollViewer Style="{StaticResource Page}">
                    <StackPanel Style="{StaticResource PageBody}">
                        <TextBlock Text="Puck" Style="{StaticResource Text.Title}" Margin="0,0,0,20" />

                        <Border Style="{StaticResource Card}" Padding="20,16" Visibility="{Binding App.IsConnected, Converter={StaticResource Visible}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{Binding App.PuckName}" Style="{StaticResource Text.Subtitle}" />
                                <Button Grid.Column="1" Grid.RowSpan="4" VerticalAlignment="Center" Content="Forget this puck" Command="{Binding ForgetCommand}" />
                                <TextBlock Grid.Row="1" Style="{StaticResource Text.Secondary}" FontSize="13" Margin="0,6,0,0">
                                    <Run Text="{Binding App.ConnectionText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding App.BatteryText, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Grid.Row="2" Style="{StaticResource Text.Secondary}" FontSize="13" Margin="0,2,0,0">
                                    <Run Text="Firmware " /><Run Text="{Binding App.Firmware, Mode=OneWay}" /><Run Text=" · showing " /><Run Text="{Binding App.FaceName, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Grid.Row="3" Style="{StaticResource Text.Caption}" Margin="0,2,0,0">
                                    <Run Text="ID " /><Run Text="{Binding App.PuckId, Mode=OneWay}" FontFamily="{StaticResource Font.Mono}" />
                                </TextBlock>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Card}" Padding="20,16" Visibility="{Binding App.IsConnected, Converter={StaticResource Visible}, ConverterParameter=not}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="No puck connected" Style="{StaticResource Text.BodyStrong}" />
                                    <TextBlock Text="These settings are sent to the puck as soon as it connects." Style="{StaticResource RowDetail}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Pair a puck" VerticalAlignment="Center" Command="{Binding PairCommand}" />
                            </Grid>
                        </Border>

                        <TextBlock Text="Screen" Style="{StaticResource Text.Section}" />
                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE706;" Style="{StaticResource RowIcon}" />
                                <TextBlock Grid.Column="1" Text="Brightness" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Style="{StaticResource ValueText}" Text="{Binding Brightness, StringFormat={}{0} %}" />
                                <Slider Grid.Column="3" Minimum="10" Maximum="100" Value="{Binding Brightness, Delay=300}" SmallChange="5" LargeChange="10"
                                        IsSnapToTickEnabled="True" TickFrequency="5" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE708;" Style="{StaticResource RowIcon}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Dim the screen" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="When nothing has happened for a while." Style="{StaticResource RowDetail}" />
                                </StackPanel>
                                <ComboBox Grid.Column="2" Width="200" ItemsSource="{x:Static ui:SettingsViewModel.DimChoices}" DisplayMemberPath="Label"
                                          SelectedValuePath="Value" SelectedValue="{Binding DimAfterSeconds}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE7E8;" Style="{StaticResource RowIcon}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Turn the screen off" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="Touch, turn or pick up the puck to wake it." Style="{StaticResource RowDetail}" />
                                </StackPanel>
                                <ComboBox Grid.Column="2" Width="200" ItemsSource="{x:Static ui:SettingsViewModel.OffChoices}" DisplayMemberPath="Label"
                                          SelectedValuePath="Value" SelectedValue="{Binding OffAfterSeconds}" />
                            </Grid>
                        </Border>

                        <TextBlock Text="Turning and sound" Style="{StaticResource Text.Section}" />
                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE7AD;" Style="{StaticResource RowIcon}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Turn sensitivity" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="How far a turn moves the volume and the other dials." Style="{StaticResource RowDetail}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Style="{StaticResource ValueText}" Text="{Binding TurnSensitivity, Converter={StaticResource Fmt}, ConverterParameter=0.00×}" />
                                <Slider Grid.Column="3" Minimum="0.25" Maximum="4" Value="{Binding TurnSensitivity, Delay=300}" SmallChange="0.05" LargeChange="0.25"
                                        IsSnapToTickEnabled="True" TickFrequency="0.05" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE8EE;" Style="{StaticResource RowIcon}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Reverse turning" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="Counter-clockwise turns things up." Style="{StaticResource RowDetail}" />
                                </StackPanel>
                                <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding FlipTurn}" Content="{Binding FlipTurn, Converter={x:Static ui:OnOff.Instance}}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE15D;" Style="{StaticResource RowIcon}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Sounds" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="Ticks as you turn, a chime when the focus timer ends." Style="{StaticResource RowDetail}" />
                                </StackPanel>
                                <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Sound}" Content="{Binding Sound, Converter={x:Static ui:OnOff.Instance}}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================================================ Mouse -->
            <TabItem Header="Trackpad and pointer" Tag="&#xE962;" x:Name="MouseTab">
                <ScrollViewer Style="{StaticResource Page}">
                    <StackPanel Style="{StaticResource PageBody}">
                        <TextBlock Text="Trackpad and pointer" Style="{StaticResource Text.Title}" Margin="0,0,0,8" />
                        <TextBlock Style="{StaticResource Text.Body}" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,0,12"
                                   Text="On the Trackpad face, the glass moves the pointer and turning scrolls. Lift the puck and aim it at the screen to point; tap to click." />

                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xEFA5;" Style="{StaticResource RowIcon}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Trackpad speed" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="Flat on the desk, finger on the glass." Style="{StaticResource RowDetail}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Style="{StaticResource ValueText}" Text="{Binding TrackpadSpeed, Converter={StaticResource Fmt}, ConverterParameter=0.0×}" />
                                <Slider Grid.Column="3" Minimum="0.5" Maximum="8" Value="{Binding TrackpadSpeed, Delay=300}" IsSnapToTickEnabled="True" TickFrequency="0.25" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE7C9;" Style="{StaticResource RowIcon}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Pointer speed" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="Lifted, aimed at the screen: pixels per degree." Style="{StaticResource RowDetail}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Style="{StaticResource ValueText}" Text="{Binding PointerSpeed, Converter={StaticResource Fmt}, ConverterParameter=0}" />
                                <Slider Grid.Column="3" Minimum="5" Maximum="90" Value="{Binding PointerSpeed, Delay=300}" IsSnapToTickEnabled="True" TickFrequency="1" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xEC8F;" Style="{StaticResource RowIcon}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Scroll speed" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="Turning the puck on the Trackpad face." Style="{StaticResource RowDetail}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Style="{StaticResource ValueText}" Text="{Binding ScrollSpeed, Converter={StaticResource Fmt}, ConverterParameter=0.00×}" />
                                <Slider Grid.Column="3" Minimum="0.25" Maximum="4" Value="{Binding ScrollSpeed, Delay=300}" IsSnapToTickEnabled="True" TickFrequency="0.05" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xEC4A;" Style="{StaticResource RowIcon}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Acceleration" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="Slow movements stay precise; quick ones go further." Style="{StaticResource RowDetail}" />
                                </StackPanel>
                                <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding MouseAcceleration}" Content="{Binding MouseAcceleration, Converter={x:Static ui:OnOff.Instance}}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================================================ Claude -->
            <TabItem Header="Claude" Tag="&#xE8BD;" x:Name="ClaudeTab">
                <ScrollViewer Style="{StaticResource Page}">
                    <StackPanel Style="{StaticResource PageBody}">
                        <TextBlock Text="Claude" Style="{StaticResource Text.Title}" Margin="0,0,0,8" />
                        <TextBlock Style="{StaticResource Text.Body}" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,0,12"
                                   Text="On the Claude face, tap and talk, then tap again to send. Windows turns your voice into text on this PC; only the text goes to Claude." />

                        <TextBlock Text="API key" Style="{StaticResource Text.Section}" Margin="2,8,0,8" />
                        <Border Style="{StaticResource Card}" Padding="16,14">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <PasswordBox x:Name="ApiKeyBox" />
                                    <Button Grid.Column="1" Content="Save" Margin="8,0,0,0" Style="{StaticResource Button.Accent}" Click="OnSaveApiKey" />
                                    <Button Grid.Column="2" Content="Remove" Margin="8,0,0,0" Click="OnClearApiKey"
                                            Visibility="{Binding HasStoredApiKey, Converter={StaticResource Visible}}" />
                                </Grid>
                                <TextBlock Text="{Binding ApiKeyStatus}" Style="{StaticResource Text.Caption}" Margin="2,8,0,0" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Conversation" Style="{StaticResource Text.Section}" />
                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE950;" Style="{StaticResource RowIcon}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Model" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="The Claude model that answers." Style="{StaticResource RowDetail}" />
                                </StackPanel>
                                <TextBox Grid.Column="2" Width="240" Text="{Binding ClaudeModel}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,4">
                            <StackPanel>
                                <TextBlock Text="Instructions" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="Sent with every conversation. Keep replies short: the puck's screen is small." Style="{StaticResource RowDetail}" Margin="0,2,0,10" />
                                <TextBox Text="{Binding ClaudeSystemPrompt}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="96" VerticalContentAlignment="Top" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE767;" Style="{StaticResource RowIcon}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Read replies aloud" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="With a Windows voice, on this PC's speakers." Style="{StaticResource RowDetail}" />
                                </StackPanel>
                                <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding SpeakReplies}" Content="{Binding SpeakReplies, Converter={x:Static ui:OnOff.Instance}}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xF2B7;" Style="{StaticResource RowIcon}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Speech language" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="A language tag such as en-US. Empty uses Windows' display language." Style="{StaticResource RowDetail}" />
                                </StackPanel>
                                <TextBox Grid.Column="2" Width="120" Text="{Binding SpeechLanguage}" />
                            </Grid>
                        </Border>

                        <TextBlock Text="Claude Code" Style="{StaticResource Text.Section}" />
                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE916;" Style="{StaticResource RowIcon}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Wait for an answer" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="Seconds the puck waits before Claude Code asks in the terminal instead." Style="{StaticResource RowDetail}" />
                                </StackPanel>
                                <TextBox Grid.Column="2" Width="80" Text="{Binding ClaudeCodeTimeoutSeconds}" TextAlignment="Right" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xEA8F;" Style="{StaticResource RowIcon}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Notifications on the puck" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="When Claude Code is waiting for you." Style="{StaticResource RowDetail}" />
                                </StackPanel>
                                <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ClaudeCodeNotifications}" Content="{Binding ClaudeCodeNotifications, Converter={x:Static ui:OnOff.Instance}}" />
                            </Grid>
                        </Border>
                        <TextBlock Style="{StaticResource Text.Caption}" Margin="2,8,0,0"
                                   Text="Install the Claude Code hook from Integrations." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================================================ Integrations -->
            <TabItem Header="Integrations" Tag="&#xE71D;" x:Name="IntegrationsTab">
                <ScrollViewer Style="{StaticResource Page}">
                    <StackPanel Style="{StaticResource PageBody}">
                        <TextBlock Text="Integrations" Style="{StaticResource Text.Title}" Margin="0,0,0,20" />
                        <ItemsControl ItemsSource="{Binding App.Integrations}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="ui:IntegrationItem">
                                    <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,8">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource RowIcon}" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}" Style="{StaticResource RowTitle}" />
                                                    <TextBlock Text="{Binding Status}" Style="{StaticResource RowDetail}" />
                                                </StackPanel>
                                                <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Enabled}"
                                                          Content="{Binding Enabled, Converter={x:Static ui:OnOff.Instance}}"
                                                          Visibility="{Binding HasToggle, Converter={StaticResource Visible}}" />
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding Actions}" Margin="38,12,0,0"
                                                          Visibility="{Binding HasActions, Converter={StaticResource Visible}}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="ui:ActionItem">
                                                        <Button Content="{Binding Label}" Command="{Binding Command}" Margin="0,0,8,4" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Caption}" Margin="38,4,0,0"
                                                       Visibility="{Binding HasMessage, Converter={StaticResource Visible}}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource Text.Caption}" Margin="2,4,0,0"
                                   Visibility="{Binding App.Integrations.Count, Converter={StaticResource Visible}, ConverterParameter=not}"
                                   Text="This build of Puck has no integrations." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================================================ Firmware -->
            <TabItem Header="Firmware" Tag="&#xE835;" x:Name="FirmwareTab">
                <ScrollViewer Style="{StaticResource Page}" DataContext="{Binding Firmware}">
                    <StackPanel Style="{StaticResource PageBody}">
                        <TextBlock Text="Firmware" Style="{StaticResource Text.Title}" Margin="0,0,0,8" />
                        <TextBlock Style="{StaticResource Text.Body}" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,0,16"
                                   Text="Install Puck on a Waveshare ESP32-S3-Touch-AMOLED-1.75C, or update it. Plug the board in with a USB-C data cable first." />

                        <Border Style="{StaticResource Card}" Padding="20,18">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE835;" Style="{StaticResource RowIcon}" />
                                    <TextBlock Grid.Column="1" Text="{Binding BundleText}" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
                                </Grid>

                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Port" Style="{StaticResource Text.Body}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding Ports}" SelectedItem="{Binding SelectedPort}" HorizontalAlignment="Left" Width="300"
                                              IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}" />
                                    <Button Grid.Column="2" Content="Refresh" Command="{Binding RefreshCommand}" />
                                </Grid>
                                <TextBlock Text="{Binding PortHint}" Style="{StaticResource Text.Secondary}" Margin="0,8,0,0" TextWrapping="Wrap"
                                           Visibility="{Binding HasPortHint, Converter={StaticResource Visible}}" />
                                <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Left" Margin="0,14,0,0" IsChecked="{Binding EraseFirst}"
                                          Content="Erase everything first (forgets pairings)" />

                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                        <Button Content="Install" Style="{StaticResource Button.Accent}" MinWidth="120"
                                                Command="{Binding InstallCommand}" IsEnabled="{Binding CanInstall}" />
                                        <Button Content="Cancel" Margin="8,0,0,0" Command="{Binding CancelCommand}"
                                                Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                        <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="1"
                                                     Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" />
                                        <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Secondary}" Margin="0,6,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBox Margin="0,12,0,0" Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" FontFamily="{StaticResource Font.Mono}"
                                 FontSize="12" Height="180" TextWrapping="NoWrap" VerticalContentAlignment="Top"
                                 Visibility="{Binding LogText, Converter={StaticResource Visible}}" TextChanged="OnFirmwareLogChanged" />
                        <TextBlock Style="{StaticResource Text.Caption}" Margin="2,12,0,0"
                                   Text="If it can't connect: hold BOOT on the board while you plug it in, then press Install again." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================================================ Log -->
            <TabItem Header="Log" Tag="&#xE9D9;" x:Name="LogTab">
                <Grid Margin="28,20,36,24" DataContext="{Binding Log}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="Log" Style="{StaticResource Text.Title}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="Copy all" Command="{Binding CopyCommand}" Margin="0,0,8,0" />
                            <Button Content="Open log folder" Command="{Binding OpenFolderCommand}" />
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                        <ListBox x:Name="LogList" ItemsSource="{Binding Entries}" Background="Transparent" BorderThickness="0"
                                 FontFamily="{StaticResource Font.Mono}" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel" Padding="8"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd" Padding="6,2" CornerRadius="3" Background="Transparent">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Selection}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="app:LogEntry">
                                    <TextBlock Text="{Binding Mode=OneWay}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ============================================================ About -->
            <TabItem Header="About" Tag="&#xE946;" x:Name="AboutTab">
                <ScrollViewer Style="{StaticResource Page}">
                    <StackPanel Style="{StaticResource PageBody}">
                        <TextBlock Text="About" Style="{StaticResource Text.Title}" Margin="0,0,0,20" />
                        <Border Style="{StaticResource Card}" Padding="20,18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:PuckPreview Width="64" Height="64" Volume="62" Face="home" IsConnected="True" />
                                <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Puck for Windows" Style="{StaticResource Text.Subtitle}" />
                                    <TextBlock Text="{Binding Version}" Style="{StaticResource Text.Secondary}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <TextBlock Style="{StaticResource Text.Body}" Foreground="{DynamicResource Brush.TextSecondary}" Margin="2,16,0,0"
                                   Text="A round dial for your desk, on a Waveshare ESP32-S3-Touch-AMOLED-1.75C. Turn it for volume; switch faces with the side button for a trackpad, a focus timer, Claude and more." />
                        <TextBlock Style="{StaticResource Text.Caption}" Margin="2,12,0,0"
                                   Text="Inspired by Watt, the puck for the Mac. DialKit is by Josh Puckett; pages using dialkit-watt work with Puck too." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
