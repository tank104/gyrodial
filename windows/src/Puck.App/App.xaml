<Application x:Class="Puck.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- index 0 is swapped for Light.xaml by ThemeManager -->
                <ResourceDictionary Source="pack://application:,,,/UI/Theme/Dark.xaml" />
                <ResourceDictionary Source="pack://application:,,,/UI/Theme/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
