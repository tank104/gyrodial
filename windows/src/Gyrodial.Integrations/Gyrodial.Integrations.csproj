<Project Sdk="Microsoft.NET.Sdk">
  <!-- Claude (voice chat), Claude Code approvals, DialKit / game pages, and Teams. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>Gyrodial.Integrations</RootNamespace>
    <UseWPF>true</UseWPF>
  </PropertyGroup>
  <ItemGroup>
    <!-- Kestrel, for the Claude Code hook endpoint and the DialKit WebSocket on 127.0.0.1 -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Gyrodial.Core\Gyrodial.Core.csproj" />
    <ProjectReference Include="..\GyrodialHook\GyrodialHook.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Anthropic" Version="12.58.0" />
    <PackageReference Include="System.Speech" Version="10.0.13" />
  </ItemGroup>

  <!-- On `dotnet build`, gyrodial-hook.exe travels with this assembly into the app's folder, where the
       "Install Claude Code hook" button expects it. `dotnet publish` leaves it out: scripts/build.ps1
       publishes a standalone gyrodial-hook.exe there instead. -->
  <Target Name="IncludeGyrodialHook" BeforeTargets="AssignTargetPaths" Condition="'$(_IsPublishing)' != 'true'">
    <MSBuild Projects="..\GyrodialHook\GyrodialHook.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_GyrodialHookTarget" />
    </MSBuild>
    <PropertyGroup>
      <_GyrodialHookDir>@(_GyrodialHookTarget->'%(RootDir)%(Directory)')</_GyrodialHookDir>
    </PropertyGroup>
    <ItemGroup>
      <None Include="$(_GyrodialHookDir)gyrodial-hook.exe;$(_GyrodialHookDir)gyrodial-hook.dll;$(_GyrodialHookDir)gyrodial-hook.runtimeconfig.json;$(_GyrodialHookDir)gyrodial-hook.deps.json"
            Condition="Exists('$(_GyrodialHookDir)gyrodial-hook.exe')" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    </ItemGroup>
  </Target>
</Project>
