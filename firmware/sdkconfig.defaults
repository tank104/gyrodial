# Gyrodial on the Waveshare ESP32-S3-Touch-AMOLED-1.75C (ESP32-S3R8, 8 MB octal PSRAM, 32 MB flash).
# idf.py builds sdkconfig from this file; delete sdkconfig to pick up changes made here.

CONFIG_IDF_TARGET="esp32s3"

# ---- flash: the GD25Q256 is used as 16 MB, quad I/O at 80 MHz. (The bootloader's own header
# stays DIO, which the ROM needs; the bootloader then switches the chip to QIO.)
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# ---- CPU and memory
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# Two universal MACs (Wi-Fi = base, Bluetooth = base + 1), as the board has always used: the BLE
# address and the "Gyrodial-XXXX" name come from the Bluetooth MAC, and PCs remember them
CONFIG_ESP32S3_UNIVERSAL_MAC_ADDRESSES_TWO=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096

# ---- FreeRTOS: 1 ms ticks; the main loop (LVGL and the protocol) runs on core 1
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_AFFINITY_CPU1=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# ---- console and logs on UART0 (GPIO43/44): the USB port carries nothing but the app's NDJSON
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y

# ---- a crash is saved to the coredump partition; `idf.py coredump-info` reads it back
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y

# ---- the display's SPI completion callback calls into LVGL (in flash): keep that ISR out of IRAM
# so it is simply held off while the flash is busy (an NVS write), never run with the cache off
# CONFIG_SPI_MASTER_ISR_IN_IRAM is not set

# ---- Bluetooth LE: NimBLE, peripheral only, no bonding (pairing is the app's own, see PROTOCOL.md)
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
# CONFIG_BT_NIMBLE_ROLE_CENTRAL is not set
# CONFIG_BT_NIMBLE_ROLE_OBSERVER is not set
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=2
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=515
# CONFIG_BT_NIMBLE_NVS_PERSIST is not set
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y
CONFIG_BT_NIMBLE_PINNED_TO_CORE_0=y
CONFIG_BT_NIMBLE_SVC_GAP_DEVICE_NAME="Gyrodial"

# ---- LVGL: configured by include/lv_conf.h, not Kconfig
# CONFIG_LV_CONF_SKIP is not set
